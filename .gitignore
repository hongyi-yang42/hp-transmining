# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
build/
dist/

# Environment
.env
.env.local

# Data — all stages gitignored (raw PDFs, page PNGs, OCR JSONL, cleaned text, segmented, aligned, embeddings)
data/

# Models, vendor, artifacts, scratch.
# vendor/ uses /* (not bare /) so specific files inside can be re-included
# by negation below; the conll-extractor checkout itself stays ignored.
models/
vendor/*
artifacts/
tmp/

# Tracked vendor manifest: pins the conll-extractor commit so CI can verify
# the vendored checkout matches the validated revision.
!vendor/conll-extractor.commit

# Copyright-bound file types (defense in depth)
*.pdf
*.png
*.jpg
*.jpeg
*.epub
*.npy
*.pkl

# Caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor / IDE local state
.vscode/
.idea/

# Local-only Claude context (project internals, acquisition info, SHA-256 of source PDFs)
CLAUDE.local.md

# Local-only config overrides (e.g., real expected_sha256 for hash verification)
config/*.local.yaml
config/local/
